# Subdomínios *.gvee.com.br que não são locatários APEX (19/10/2026, G16/G18).
# Nomes exatos (apex-tenants, beta, gvee.com.br/www, api) têm prioridade sobre o curinga abaixo.
# Certificado: o de gvee.com.br (Cloudflare em modo Full aceita o nome divergente).

map $http_upgrade $connection_upgrade_gvee {
    default upgrade;
    ''      close;
}

# api.gvee.com.br -> Supabase (Kong :8000) com HTTPS — URL pública do Supabase no app
server {
    listen 80;
    server_name api.gvee.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.gvee.com.br;

    ssl_certificate     /etc/letsencrypt/live/gvee.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gvee.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    server_tokens off;
    client_max_body_size 50M;

    access_log /var/log/nginx/gvee-api.access.log;
    error_log  /var/log/nginx/gvee-api.error.log;

    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade_gvee;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}

# vps.gvee.com.br (Incontre) e qualquer outro subdomínio -> app Next.js.
# O proxy.ts resolve o locatário pelo subdomínio; se não existir em adm000, manda para https://gvee.com.br/.
server {
    listen 80;
    server_name vps.gvee.com.br *.gvee.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name vps.gvee.com.br *.gvee.com.br;

    ssl_certificate     /etc/letsencrypt/live/gvee.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gvee.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    server_tokens off;
    client_max_body_size 20M;

    access_log /var/log/nginx/gvee.access.log;
    error_log  /var/log/nginx/gvee.error.log;

    location /storage/v1/object/public/ {
        limit_except GET HEAD { deny all; }
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
        expires            1h;
    }

    location / {
        proxy_pass         http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        'upgrade';
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
