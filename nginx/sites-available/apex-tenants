# CLIENTE 1: Incontre (GIDL = 1)
server {
    listen 80;
    listen 443 ssl;
    server_name incontre.gvee.com.br;

    ssl_certificate /etc/letsencrypt/live/incontre.gvee.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/incontre.gvee.com.br/privkey.pem;

    # Se o cliente acessar a raiz /, manda direto para a aplicação com o GIDL:1
    location = / {
        return 301 https://$host/ords/f?p=110:9999:::::GIDL:1:;
    }

    # Repassa todo o tráfego do ORDS para a nuvem da Oracle
    location /ords/ {
        proxy_pass https://ga35b71c8540c5f-incontredb01.adb.sa-vinhedo-1.oraclecloudapps.com/ords/;

        # Headers padrão de encaminhamento
        proxy_set_header Host ga35b71c8540c5f-incontredb01.adb.sa-vinhedo-1.oraclecloudapps.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;

        # CORREÇÃO DO FORBIDDEN: Mascara as origens para passar na validação CSRF do APEX
        proxy_set_header Origin https://ga35b71c8540c5f-incontredb01.adb.sa-vinhedo-1.oraclecloudapps.com;
        proxy_set_header Referer https://ga35b71c8540c5f-incontredb01.adb.sa-vinhedo-1.oraclecloudapps.com;

        # Evita que o ORDS mude a URL na barra de endereço do cliente
        proxy_redirect https://ga35b71c8540c5f-incontredb01.adb.sa-vinhedo-1.oraclecloudapps.com/ /;

        # Buffers otimizados para sessões e tokens grandes do APEX
        proxy_buffer_size          128k;
        proxy_buffers              4 256k;
        proxy_busy_buffers_size    256k;
    }

    # Repassa os arquivos de estilo, ícones e JS do APEX
    location /i/ {
        proxy_pass https://ga35b71c8540c5f-incontredb01.adb.sa-vinhedo-1.oraclecloudapps.com;
        proxy_set_header Host ga35b71c8540c5f-incontredb01.adb.sa-vinhedo-1.oraclecloudapps.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}

